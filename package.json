{
  "name": "qa-auto-stack",
  "version": "2.0.0",
  "description": "Multi-Framework Test Automation Stack - Selenium, WebDriverIO, and Cypress with TypeScript",
  "type": "module",
  "main": "dist/mcp-server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/mcp-server.js",
    "dev": "tsx src/mcp-server.ts",
    "setup": "npm install && npm run build",
    "clean": "rm -rf dist/ reports/ test-results/",
    "clean:reports": "tsx scripts/clean-reports.ts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "FRAMEWORK=webdriverio tsx tests/runner.ts",
    "test:all": "npm run test:selenium && npm run test:webdriverio && npm run test:cypress",
    "test:selenium": "FRAMEWORK=selenium tsx tests/runner.ts",
    "test:webdriverio": "FRAMEWORK=webdriverio tsx tests/runner.ts",
    "test:cypress": "FRAMEWORK=cypress tsx tests/runner.ts",
    "test:chrome": "BROWSER=chrome tsx tests/runner.ts",
    "test:firefox": "BROWSER=firefox tsx tests/runner.ts",
    "test:safari": "BROWSER=safari tsx tests/runner.ts",
    "test:headless": "HEADLESS=1 tsx tests/runner.ts",
    "mcp:server": "tsx src/mcp-server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "cypress": "^13.18.2",
    "selenium-webdriver": "^4.27.0",
    "webdriverio": "^9.20.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/chai": "^5.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.1",
    "@types/selenium-webdriver": "^4.1.28",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "chai": "^5.1.2",
    "chromedriver": "^139.0.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.1.3",
    "geckodriver": "^4.4.0",
    "glob": "^11.0.0",
    "mocha": "^11.0.1",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.46.4"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "selenium",
    "webdriverio",
    "cypress",
    "typescript",
    "automation",
    "test-automation",
    "web-automation",
    "multi-framework",
    "qa"
  ],
  "author": "Development Team",
  "license": "MIT"
}
