{
  "name": "qa-auto-stack",
  "version": "2.0.0",
  "description": "Multi-Framework Test Automation Stack - Selenium, WebDriverIO, and Cypress with TypeScript",
  "type": "module",
  "main": "dist/mcp-server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/mcp-server.js",
    "dev": "tsx src/mcp-server.ts",
    "setup": "npm install --ignore-scripts && npm run build",
    "clean": "rm -rf dist/ reports/ test-results/",
    "clean:reports": "tsx scripts/clean-reports.ts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "mcp:server": "tsx src/mcp-server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "cypress": "^13.16.0",
    "selenium-webdriver": "^4.27.0",
    "webdriverio": "^9.20.0"
  },
  "peerDependenciesMeta": {
    "cypress": {
      "optional": true
    },
    "selenium-webdriver": {
      "optional": true
    },
    "webdriverio": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/selenium-webdriver": "^4.1.28",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "@wdio/types": "^9.20.0",
    "cypress": "^15.6.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.3.3",
    "selenium-webdriver": "^4.38.0",
    "tsx": "^4.20.5",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.46.4",
    "webdriverio": "^9.20.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "selenium",
    "webdriverio",
    "cypress",
    "typescript",
    "automation",
    "test-automation",
    "web-automation",
    "multi-framework",
    "qa"
  ],
  "author": "Development Team",
  "license": "MIT"
}
